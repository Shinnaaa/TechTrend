# Copy to .env for local runs (python fetcher.py && python summarizer.py && python pusher.py).
# .env is git-ignored. In GitHub Actions, set these as repository secrets instead.

# ── LLM (required) ── any OpenAI-compatible endpoint
OPENAI_API_KEY=
# Optional overrides of llm.base_url / llm.model in config.yml
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-v4-flash

# ── Push channels ── fill in any you use; each one with its values set is active
# PUSHPLUS_TOKEN=
# SERVERCHAN_SENDKEY=
# WECOM_WEBHOOK_URL=
# FEISHU_WEBHOOK_URL=
# FEISHU_SECRET=
# DINGTALK_WEBHOOK_URL=
# DINGTALK_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_TO=you@example.com
# EMAIL_FROM=
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=
# WEBHOOK_URL=
